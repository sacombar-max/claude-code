# Copia este archivo como .env y completa los valores

# Clave de API de Anthropic — obligatoria
# Obtén la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gmail — para recibir el informe por correo
# GMAIL_USER: tu cuenta de Gmail (ej. tunombre@gmail.com)
# GMAIL_APP_PASSWORD: contraseña de aplicación de Google (ver instrucciones)
# GMAIL_RECIPIENT: a quién enviar (puede ser el mismo correo u otro)
GMAIL_USER=tunombre@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=tunombre@gmail.com
